{
  "name": "ng-hackernews",
  "description": "A Hackernews implementation in Angular, with interface inspired by Nytimes.",
  "version": "3.0.3",
  "author": {
    "name": "Shaun",
    "email": "pkay_@live.com"
  },
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "test:watch": "ng test --watch",
    "test:headless": "ng test --no-watch --no-progress --browsers=ChromeHeadless --code-coverage",
    "test-karma": "ng test --no-watch",
    "test-vitest": "ng run ng-hackernews:test-vitest",
    "coverage": "ng test --no-watch --code-coverage",
    "format": "prettier . --write",
    "check": "prettier . --check",
    "lint:css": "stylelint **/*.sass"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/platform-browser-dynamic": "^22.1.6",
    "@angular/router": "^22.1.6",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/jasmine": "~3.8.0",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^4.0.8",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~3.8.0",
    "jsdom": "^30.0.1",
    "karma": "^6.3.16",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "prettier": "^3.2.4",
    "stylelint": "^16.2.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=22.22.3 <23.0.0"
  }
}